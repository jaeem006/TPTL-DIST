           → ↑d₃ {Γ} {u} {v} {w} {x} d ≡ ↑d₀ {Γ ، u ، v ، w} {x} (↑d₂ {Γ} {u} {v} {w} d)
↑d₃≡↑d₀↑d₂ {Γ} {u} {v} {w} {x} d =
  ↑d-trans (⊆₃ {Γ} {u} {v} {w} {x}) (⊆₂ {Γ} {u} {v} {w}) (⊆₀ {Γ ، u ، v ، w} {x}) d
           (λ w i → refl)

↑d₂≡↑d₀↑d₁ : {Γ : Ctxt} {u v w : 𝕍} (d : Data Γ)
           → ↑d₂ {Γ} {u} {v} {w} d ≡ ↑d₀ {Γ ، u ، v} {w} (↑d₁ {Γ} {u} {v} d)
↑d₂≡↑d₀↑d₁ {Γ} {u} {v} {w} d =
