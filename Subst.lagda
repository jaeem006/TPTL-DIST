           (λ w i → refl)

↑ᵢ₁≡↑ᵢ₀↑ᵢ₀ : {Γ : Ctxt} {u v : 𝕍} (a : Agent Γ)
           → ↑ᵢ₁ {Γ} {u} {v} a ≡ ↑ᵢ₀ {Γ ، u} {v} (↑ᵢ₀ {Γ} {u} a)
↑ᵢ₁≡↑ᵢ₀↑ᵢ₀ {Γ} {u} {v} a =
